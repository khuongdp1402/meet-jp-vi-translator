{
  "manifest_version": 3,
  "name": "Meet EN-JA-VI IT Infra Translator & History",
  "version": "2.0.1",
  "description": "Dịch đa ngôn ngữ Anh - Nhật - Việt realtime trên Google Meet chuyên sâu ngành IT Infra, tự động ngắt câu theo nghĩa và lưu danh sách lịch sử & tổng hợp cuộc họp.",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*",
    "https://clients5.google.com/*",
    "https://api.mymemory.translated.net/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Meet EN-JA-VI IT Infra Translator & History",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content/caption-observer.js",
        "content/ui-overlay.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen/offscreen.html",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
